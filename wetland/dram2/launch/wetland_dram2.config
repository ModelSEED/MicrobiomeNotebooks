// wetland_dram2.config -- extra `-c` config for running chenry's DRAM2 v2.0.0-beta17 install
// (/scratch1/fliu/hub_scratch/chenry/DRAM2/repo, read-only) as afreiburger on poplar.
//
// 1) Hard cap on what this Nextflow instance schedules: 56 CPU slots / 400 GB in total (keeps
//    measured real CPU use <= 64 cores, see executor block).
// 2) Per-label request caps (DRAM2 defaults are huge = 24 CPUs / 200 GB per MMseqs task).
// 3) Every module's conda env is pinned to an explicit, already-built prefix, so Nextflow
//    never creates or modifies an env:
//      - annotate + multiqc envs: chenry's envs built at the /scratch1 path, used READ-ONLY
//      - call, collect_rna, rename, distill, product: built by afreiburger from the exact
//        beta17 environment.yml files (bin/make_envs.sh), because chenry's copies of the first
//        three were built under /storage/chenry/DRAM2 (popjup path, absent on poplar) and the
//        last two were never built.

conda {
    enabled       = true
    useMicromamba = true      // activation only (micromamba copied to bin/); no env is ever built
    cacheDir      = '/scratch1/afreiburger/wetland_dram2/conda_cache'
}

// 56 slots, not 64: each running task also costs ~0.3 core of Nextflow's own per-task trace
// polling (bash + ps on this ~5k-process host), and hmmsearch --cpu 2 has a parsing master
// thread on top of its 2 workers. Measured at 64 slots: 30 hmmsearch = 50 cores + 9 cores of
// wrapper bash = 59-67 cores. 56 slots keeps the real total at or below 64.
executor {
    name   = 'local'
    cpus   = 56
    memory = '400 GB'
}

params {
    tiny_cpus_limit     = 1
    small_cpus_limit    = 2      // hmmsearch hard-codes --cpu 2
    medium_cpus_limit   = 4
    big_cpus_limit      = 8
    huge_cpus_limit     = 2      // MMseqs2 searches (merops/camper/canthyd/methyl); 3-MAG test: 0.6-7.6 cores, RSS <3 GB.
                                 // Must equal the hmmsearch size (2): the local executor submits whatever
                                 // fits, so 4-slot tasks starved behind the 2-slot stream (1 of 948 ran).

    tiny_gb_mem_limit   = 2
    small_gb_mem_limit  = 8
    medium_gb_mem_limit = 48
    big_gb_mem_limit    = 64
    huge_gb_mem_limit   = 16

    // poplar runs at load ~450 on 336 threads; give per-task wall limits headroom
    tiny_hr_time_limit   = 6
    small_hr_time_limit  = 24
    medium_hr_time_limit = 48
    big_hr_time_limit    = 48
    huge_hr_time_limit   = 168
}

env {
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    NUMEXPR_NUM_THREADS  = '1'
}

process {
    // never let one task ask for more than this, whatever the attempt multiplier does
    resourceLimits = [ cpus: 16, memory: 200.GB, time: 168.h ]

    withName: '.*RENAME_FASTA'                                   { conda = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_rename" }
    withName: '.*CALL_GENES'                                     { conda = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_call" }
    withName: '.*(TRNA_SCAN|RRNA_SCAN|TRNA_COLLECT|RRNA_COLLECT)' { conda = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_collect_rna" }
    withName: '.*(GENE_LOCS|HMM_SEARCH_.*|PARSE_HMM_.*|.*_HMM_FORMATTER|MMSEQS_INDEX|MMSEQS_SEARCH_.*|SQL_.*|COMBINE_ANNOTATIONS|MERGE_ANNOTATIONS)' {
        conda = '/scratch1/fliu/hub_scratch/chenry/DRAM2/nxf-scratch/conda_cache/env-fd46c7768a790ad1-f25d581e073c803fd2df039b7aadc6c8'
    }
    withName: '.*MULTIQC'                                        { conda = '/scratch1/fliu/hub_scratch/chenry/DRAM2/nxf-scratch/conda_cache/env-152dac747f07927d-eec4e05336245ea50db6412788f8c4da' }
    withName: '.*DISTILL.*'                           { conda = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_distill" }
    withName: '.*PRODUCT_HEATMAP'                                { conda = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_product" }

    // QUAST sizes its worker pool as multiprocessing.cpu_count()//4 = 84 on poplar and the
    // module passes no -t; confine the task to 4 random logical CPUs so the 64-CPU cap holds.
    withName: '.*QUAST' {
        conda        = "/scratch1/afreiburger/wetland_dram2/conda_cache/dram2_beta17_call"
        cpus         = 4
        beforeScript = 'taskset -a -c -p "$(shuf -i 0-$(( $(nproc --all) - 1 )) -n 4 | paste -sd, -)" $$ >/dev/null 2>&1 || true'
    }

    // per-MAG MMseqs2 query DBs + indexes are pure intermediates: keep them in work/ only
    withName: '.*MMSEQS_INDEX' { publishDir = [ enabled: false ] }
    // every HMM_SEARCH_<db> / PARSE_HMM_<db> alias writes <mag>_hmmsearch.out / <mag>_parsed_hmm.out,
    // so the published copies of different databases overwrite each other in HMM_search/;
    // the per-database formatted hits (<mag>___formatted_<db>_hits.csv) are still published
    withName: '.*HMM_SEARCH_(DBCAN|VOG|CAMPER|CANTHYD|SULFUR|FEGENIE)' { publishDir = [ enabled: false ] }
    withName: '.*PARSE_HMM_.*'  { publishDir = [ enabled: false ] }
    // ...except KOfam's raw --domtblout, kept in its own dir: beta17 never applies KOfam's per-KO
    // thresholds and keeps no domain scores, so this is the only input for re-thresholding the
    // "domain"-type KOs properly (~45 MB per MAG).
    withName: '.*HMM_SEARCH_KOFAM' {
        publishDir = [ path: { "${params.outdir}/HMM_search_kofam_raw" }, mode: 'copy' ]
    }
}
